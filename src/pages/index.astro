---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/posts';
// 手动更新时按发布时间从新到旧排列，首条始终显示为大图。
const recentVideos = [
  { title: '【最终幻想共鸣】全角色专属装备 分析介绍、获取攻略指南', views: '3206', date: '10月25日', bvid: 'BV1fvH56cEkF', cover: '/videos/covers/BV1fvH56cEkF.webp' },
  { title: '【最终幻想 共鸣】直面巅峰最强纹章士 最高难度 击破萨菲罗斯！', views: '2.1万', date: '10月24日', bvid: 'BV1G4HP6oEQo', cover: '/videos/covers/BV1G4HP6oEQo.webp' },
  { title: '【破浪而行】小而美的搜打撤肉鸽 - 试玩实况！', views: '4370', date: '10月20日', bvid: 'BV1PjnP66Ex1', cover: '/videos/covers/BV1PjnP66Ex1.webp' },
  { title: '【火焰纹章】选择焦虑？神将适配 ？全职业分析与角色推荐指南', views: '4.9万', date: '10月18日', bvid: 'BV1b1nV6rE7x', cover: '/videos/covers/BV1b1nV6rE7x.jpg' },
  { title: '【火焰纹章】真要我玩一辈子万缕千丝啊，DLC 终于来啦！', views: '3.6万', date: '10月15日', bvid: 'BV1crJ66KEi9', cover: '/videos/covers/BV1crJ66KEi9.jpg' },
];
const featuredVideo = recentVideos[0];

const videoUrl = (video: (typeof recentVideos)[number]) => video.bvid
  ? `https://www.bilibili.com/video/${video.bvid}/`
  : `https://search.bilibili.com/all?keyword=${encodeURIComponent(video.keyword ?? video.title)}`;

---

<BaseLayout title={site.name} description={site.description} pageClass="home-page">
  <section class="hero">
    <div class="hero__intro">
      <img
        src="/avatars/pser-hanser-avatar.jpg"
        alt="Pser_hanser 头像"
        class="hero__avatar"
        width="80"
        height="80"
      />
      <h1 class="hero__title">你好，这里是 Pser_hanser 的攻略聚合页 感谢关注！</h1>
      <div class="hero__profile" aria-label="个人简介">
        <p>频道视频方向主要是，游戏攻略、评测以及相关解析</p>
        <p>
          全网同名：<strong>Pser_hanser</strong>
          <span class="hero__social-label">这里可以找到我</span>
          <span class="hero__social" aria-label="社交链接">
            <a class="icon-button" href="https://space.bilibili.com/43477533" target="_blank" rel="noopener noreferrer" aria-label="Bilibili">
              <Icon name="bilibili" />
            </a>
            <a class="icon-button" href="https://v.douyin.com/xWTt59cOjDU/" target="_blank" rel="noopener noreferrer" aria-label="抖音">
              <Icon name="douyin" />
            </a>
            <a class="icon-button" href="https://www.youtube.com/@Pser_hanser" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <Icon name="youtube" />
            </a>
          </span>
        </p>
      </div>
      <p class="hero__bio">
        这里用于陈列个人以往制作的文档资源，做的一些网站。希望可以帮到你，对了后续都会在这里更新攻略资料 <strong>记得回来随时查看哦</strong>
      </p>
      <div class="hero__actions">
        <a class="hero__resource-link" href="/archive/">
          <span>浏览攻略资源</span>
          <span class="hero__resource-hint" aria-hidden="true">点击查看</span>
          <span class="hero__resource-arrow" aria-hidden="true"><Icon name="arrow-right" size={22} /></span>
        </a>
      </div>
    </div>

    <section class="video-showcase" aria-labelledby="latest-videos-title">
      <h2 id="latest-videos-title" class="video-showcase__heading">最新视频</h2>
      <div class="video-showcase__grid">
        <a class="video-feature" href={videoUrl(featuredVideo)} target="_blank" rel="noopener noreferrer">
          <img src={featuredVideo.cover} alt={`${featuredVideo.title} 视频封面`} loading="lazy" />
          <span class="video-feature__meta"><span>{featuredVideo.views} 播放</span></span>
          <span class="video-feature__title">{featuredVideo.title}</span>
        </a>
        <ol class="video-list" aria-label="近期投稿">
          {recentVideos.slice(1).map((video) => (
            <li>
              <a href={videoUrl(video)} target="_blank" rel="noopener noreferrer">
                <img class="video-list__cover" src={video.cover} alt="" loading="lazy" />
                <span class="video-list__text"><strong>{video.title}</strong><small>{video.date} · {video.views} 播放</small></span>
                <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </section>
</BaseLayout>
