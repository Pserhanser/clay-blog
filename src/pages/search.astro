---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="搜索"
  description="搜索攻略文档、游戏 Wiki、网盘资源和博客文章。"
  pageClass="content-page"
>
  <section class="search-page">
    <header class="page-header">
      <p class="eyebrow">Search</p>
      <h1>搜索资源与文章</h1>
      <p>输入游戏名或关键词，查找攻略文档、Wiki、资料表、网盘资源和文章。</p>
    </header>

    <form class="search-box" role="search">
      <label for="search-input">关键词</label>
      <div class="search-box__control">
        <input
          id="search-input"
          name="q"
          type="search"
          placeholder="最终幻想、火纹、P3R、网盘资源…"
          autocomplete="off"
        />
        <button type="submit">搜索</button>
      </div>
    </form>

    <p class="search-status" data-search-status role="status" aria-live="polite">正在加载索引…</p>
    <button type="button" class="search-retry" data-search-retry hidden>重新加载索引</button>
    <div class="search-results post-list" data-search-results></div>
  </section>

  <script>
    import '../scripts/search';
  </script>
</BaseLayout>
